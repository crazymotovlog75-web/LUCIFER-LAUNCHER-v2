<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent">

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/server_hub_split"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.32" />

    <LinearLayout
        android:id="@+id/server_hub_left_panel"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/_14sdp"
        android:paddingTop="@dimen/_12sdp"
        android:paddingBottom="@dimen/_10sdp"
        android:background="#B40A0D15"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/server_hub_split">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">
            <TextView
                android:id="@+id/server_hub_back"
                android:layout_width="@dimen/_42sdp"
                android:layout_height="@dimen/_42sdp"
                android:gravity="center"
                android:text="‹"
                android:textColor="@color/text_primary_white"
                android:textSize="@dimen/_26ssp"
                android:background="@drawable/bg_lucifer_nav_item"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="Back" />
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:paddingStart="@dimen/_8sdp"
                android:text="Server Hub"
                android:textColor="@color/text_primary_white"
                android:textSize="@dimen/_18ssp"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_8sdp"
            android:paddingStart="@dimen/_50sdp"
            android:text="Live Java server status and one-tap join."
            android:textColor="@color/text_secondary_light"
            android:textSize="@dimen/_9ssp"
            android:maxLines="2" />

        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/server_hub_count"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/_9sdp"
            android:text="1 server · checking now"
            android:textColor="@color/text_secondary_light"
            android:textSize="@dimen/_10ssp"
            android:letterSpacing="0.03" />

        <LinearLayout
            android:id="@+id/server_hub_actions"
            android:layout_width="match_parent"
            android:layout_height="@dimen/_44sdp"
            android:orientation="horizontal"
            android:gravity="center_vertical">
            <TextView
                android:id="@+id/btn_server_refresh_all"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:text="↻"
                android:textColor="@color/text_primary_white"
                android:textSize="@dimen/_14ssp"
                android:textStyle="bold"
                android:background="@drawable/bg_server_refresh_dark"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="Refresh all server statuses" />
            <TextView
                android:id="@+id/btn_server_add"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="@dimen/_8sdp"
                android:gravity="center"
                android:text="＋  Add"
                android:textColor="#151923"
                android:textSize="@dimen/_10ssp"
                android:textStyle="bold"
                android:background="@drawable/bg_server_add_light"
                android:clickable="true"
                android:focusable="true" />
        </LinearLayout>

        <TextView
            android:id="@+id/server_hub_profile_note"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_10sdp"
            android:text="Saved servers sync to the selected profile's servers.dat. LuciferMC remains pinned."
            android:textColor="@color/text_secondary_light"
            android:textSize="@dimen/_8ssp"
            android:lineSpacingExtra="1dp" />
    </LinearLayout>

    <View
        android:id="@+id/server_hub_divider"
        android:layout_width="1dp"
        android:layout_height="0dp"
        android:background="#55FFFFFF"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="@id/server_hub_split" />

    <include
        android:id="@+id/featured_server_panel"
        layout="@layout/item_featured_server_hub"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/_10sdp"
        android:layout_marginTop="@dimen/_8sdp"
        android:layout_marginEnd="@dimen/_10sdp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toEndOf="@id/server_hub_split"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/server_hub_other_servers_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_6sdp"
        android:layout_marginStart="@dimen/_12sdp"
        android:text="OTHER SERVERS"
        android:textColor="@color/text_primary_white"
        android:textSize="@dimen/_9ssp"
        android:textStyle="bold"
        android:letterSpacing="0.1"
        app:layout_constraintTop_toBottomOf="@id/featured_server_panel"
        app:layout_constraintStart_toEndOf="@id/server_hub_split"
        app:layout_constraintEnd_toEndOf="parent" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/server_hub_list"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="@dimen/_8sdp"
        android:layout_marginTop="@dimen/_3sdp"
        android:layout_marginEnd="@dimen/_8sdp"
        android:paddingBottom="@dimen/_6sdp"
        android:clipToPadding="false"
        android:overScrollMode="never"
        app:layout_constraintTop_toBottomOf="@id/server_hub_other_servers_title"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@id/server_hub_split"
        app:layout_constraintEnd_toEndOf="parent" />

    <LinearLayout
        android:id="@+id/server_hub_empty"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="@dimen/_8sdp"
        android:layout_marginTop="@dimen/_3sdp"
        android:layout_marginEnd="@dimen/_8sdp"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="@dimen/_10sdp"
        android:background="@drawable/bg_lucifer_glass_card"
        app:layout_constraintTop_toTopOf="@id/server_hub_list"
        app:layout_constraintBottom_toBottomOf="@id/server_hub_list"
        app:layout_constraintStart_toStartOf="@id/server_hub_list"
        app:layout_constraintEnd_toEndOf="@id/server_hub_list">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="No added servers yet"
            android:textColor="@color/text_primary_white"
            android:textSize="@dimen/_12ssp"
            android:textStyle="bold" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_4sdp"
            android:text="LuciferMC stays pinned above. Add another server to manage it here."
            android:gravity="center"
            android:textColor="@color/text_secondary_light"
            android:textSize="@dimen/_8ssp" />
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
