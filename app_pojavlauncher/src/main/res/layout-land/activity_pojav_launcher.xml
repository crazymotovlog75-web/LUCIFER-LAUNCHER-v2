<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="false"
    android:background="@drawable/bg_lucifer_scene">

    <!-- Lucifer's floating glass navigation ribbon. Navigation stays horizontal on every page. -->
    <LinearLayout
        android:id="@+id/header_bar"
        android:layout_width="0dp"
        android:layout_height="@dimen/_58sdp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="@dimen/_8sdp"
        android:paddingEnd="@dimen/_8sdp"
        android:background="@drawable/bg_lucifer_header"
        android:elevation="8dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <FrameLayout
            android:id="@+id/btn_home_logo"
            android:layout_width="@dimen/_34sdp"
            android:layout_height="match_parent"
            android:background="?android:attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="Lucifer Launcher home">
            <ImageView
                android:id="@+id/iv_cs_logo"
                android:layout_width="@dimen/_28sdp"
                android:layout_height="@dimen/_28sdp"
                android:layout_gravity="center"
                android:src="@drawable/ic_lucifer_mark"
                android:scaleType="fitCenter"
                android:contentDescription="Lucifer Launcher" />
        </FrameLayout>

        <TextView
            android:id="@+id/tv_launcher_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/_4sdp"
            android:text="@string/cs_launcher_title"
            android:textSize="@dimen/_12ssp"
            android:textStyle="bold"
            android:textColor="@color/lucifer_cyan"
            android:letterSpacing="0.055"
            android:maxLines="1"
            android:background="?android:attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:paddingHorizontal="@dimen/_5sdp"
            android:paddingVertical="@dimen/_4sdp" />

        <View
            android:layout_width="1dp"
            android:layout_height="@dimen/_26sdp"
            android:layout_marginHorizontal="@dimen/_6sdp"
            android:background="#4287B9C9" />

        <HorizontalScrollView
            android:id="@+id/nav_scroll"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:fillViewport="false"
            android:overScrollMode="never"
            android:scrollbars="none">
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:id="@+id/nav_home"
                    style="@style/LuciferTopNavItem"
                    android:selected="true"
                    android:contentDescription="Home">
                    <ImageView android:id="@+id/nav_home_icon" style="@style/LuciferTopNavIcon" android:src="@drawable/ic_home" />
                    <TextView android:id="@+id/nav_home_label" style="@style/LuciferTopNavLabel" android:text="Home" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/nav_instances"
                    style="@style/LuciferTopNavItem"
                    android:contentDescription="Instances">
                    <ImageView android:id="@+id/nav_instances_icon" style="@style/LuciferTopNavIcon" android:src="@drawable/ic_folder_managed" />
                    <TextView android:id="@+id/nav_instances_label" style="@style/LuciferTopNavLabel" android:text="Instances" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/nav_servers"
                    style="@style/LuciferTopNavItem"
                    android:contentDescription="Server hub">
                    <ImageView android:id="@+id/nav_servers_icon" style="@style/LuciferTopNavIcon" android:src="@drawable/ic_mc_block" />
                    <TextView android:id="@+id/nav_servers_label" style="@style/LuciferTopNavLabel" android:text="Servers" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/nav_mod_store"
                    style="@style/LuciferTopNavItem"
                    android:contentDescription="Mod library">
                    <ImageView android:id="@+id/nav_mod_store_icon" style="@style/LuciferTopNavIcon" android:src="@drawable/ic_download_box" />
                    <TextView android:id="@+id/nav_mod_store_label" style="@style/LuciferTopNavLabel" android:text="Mods" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/nav_custom_controls"
                    style="@style/LuciferTopNavItem"
                    android:contentDescription="Custom controls">
                    <ImageView android:id="@+id/nav_controls_icon" style="@style/LuciferTopNavIcon" android:src="@drawable/ic_menu_custom_controls" />
                    <TextView android:id="@+id/nav_controls_label" style="@style/LuciferTopNavLabel" android:text="Controls" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/nav_cursor"
                    style="@style/LuciferTopNavItem"
                    android:contentDescription="Cursor Studio">
                    <ImageView android:id="@+id/nav_cursor_icon" style="@style/LuciferTopNavIcon" android:src="@drawable/ic_mouse_pointer" />
                    <TextView android:id="@+id/nav_cursor_label" style="@style/LuciferTopNavLabel" android:text="Cursor" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/nav_skin"
                    style="@style/LuciferTopNavItem"
                    android:contentDescription="Skins and capes">
                    <ImageView android:id="@+id/nav_skin_icon" style="@style/LuciferTopNavIcon" android:src="@drawable/ic_manage_skin" />
                    <TextView android:id="@+id/nav_skin_label" style="@style/LuciferTopNavLabel" android:text="Skins" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/nav_about"
                    style="@style/LuciferTopNavItem"
                    android:contentDescription="About Lucifer Launcher">
                    <ImageView android:id="@+id/nav_about_icon" style="@style/LuciferTopNavIcon" android:src="@drawable/ic_menu_news" />
                    <TextView android:id="@+id/nav_about_label" style="@style/LuciferTopNavLabel" android:text="About" />
                </LinearLayout>
            </LinearLayout>
        </HorizontalScrollView>

        <Button
            android:id="@+id/btn_client_features"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/_36sdp"
            android:layout_marginHorizontal="@dimen/_3sdp"
            android:minWidth="@dimen/_40sdp"
            android:text="✦ Pro"
            android:textSize="@dimen/_9ssp"
            android:textStyle="bold"
            android:textColor="@color/lucifer_cyan"
            android:background="@drawable/bg_lucifer_nav_item"
            android:paddingHorizontal="@dimen/_8sdp"
            android:contentDescription="Client features" />

        <com.kdt.mcgui.mcAccountSpinner
            android:id="@+id/account_spinner"
            android:layout_width="@dimen/_136sdp"
            android:layout_height="@dimen/_38sdp"
            android:dropDownWidth="wrap_content"
            android:dropDownVerticalOffset="@dimen/_40sdp"
            android:background="@drawable/bg_account_spinner"
            android:paddingStart="@dimen/_6sdp"
            android:paddingEnd="@dimen/_6sdp" />

        <ImageButton
            android:id="@+id/setting_button"
            android:layout_width="@dimen/_38sdp"
            android:layout_height="@dimen/_38sdp"
            android:layout_marginStart="@dimen/_4sdp"
            android:background="@drawable/bg_settings_btn"
            android:src="@drawable/ic_menu_settings"
            android:scaleType="fitCenter"
            android:padding="@dimen/_7sdp"
            android:contentDescription="Settings"
            android:clickable="true"
            android:focusable="true" />
    </LinearLayout>

    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/container_fragment"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/_4sdp"
        android:layout_marginBottom="@dimen/_4sdp"
        app:layout_constraintTop_toBottomOf="@+id/header_bar"
        app:layout_constraintBottom_toBottomOf="parent" />

    <com.kdt.mcgui.ProgressLayout
        android:id="@+id/progress_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:elevation="10dp"
        android:layout_marginStart="@dimen/padding_large"
        android:layout_marginEnd="@dimen/padding_large"
        android:layout_marginTop="4dp"
        app:layout_constraintTop_toBottomOf="@+id/header_bar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
