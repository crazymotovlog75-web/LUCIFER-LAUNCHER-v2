<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/launcher_world">

    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/container_fragment" android:layout_width="0dp" android:layout_height="0dp"
        app:layout_constraintStart_toEndOf="@id/launcher_rail" app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" app:layout_constraintBottom_toBottomOf="parent" />

    <LinearLayout android:id="@+id/launcher_rail" android:layout_width="@dimen/_64sdp"
        android:layout_height="0dp" android:orientation="vertical" android:gravity="center_horizontal"
        android:background="#F2070710" android:elevation="4dp"
        app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">
        <TextView android:id="@+id/tv_launcher_title" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:gravity="center" android:paddingVertical="10dp"
            android:text="@string/lucifer_launcher" android:textColor="#FFFFFF" android:textStyle="bold"
            android:textSize="@dimen/_8ssp" android:letterSpacing="0.06" android:clickable="true" android:focusable="true" />
        <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
            android:fillViewport="true" android:scrollbars="none">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:gravity="center_horizontal" android:orientation="vertical">
                <ImageButton android:id="@+id/nav_versions" style="@style/LuciferRailButton" android:src="@drawable/ic_menu_home" android:contentDescription="@string/lucifer_versions" />
                <ImageButton android:id="@+id/nav_add_account" style="@style/LuciferRailButton" android:src="@drawable/ic_lucifer_account_add" android:contentDescription="@string/lucifer_add_account" />
                <ImageButton android:id="@+id/nav_mod_store" style="@style/LuciferRailButton" android:src="@drawable/ic_mc_block" android:contentDescription="@string/lucifer_mods" />
                <ImageButton android:id="@+id/nav_files" style="@style/LuciferRailButton" android:src="@drawable/ic_folder" android:contentDescription="@string/lucifer_files" />
                <ImageButton android:id="@+id/nav_skin" style="@style/LuciferRailButton" android:src="@drawable/ic_manage_skin" android:contentDescription="@string/lucifer_edit_skin" />
                <ImageButton android:id="@+id/nav_tools" style="@style/LuciferRailButton" android:src="@drawable/ic_menu_custom_controls" android:contentDescription="@string/lucifer_tools" />
            </LinearLayout>
        </ScrollView>
    </LinearLayout>

    <LinearLayout android:layout_width="wrap_content" android:layout_height="@dimen/_42sdp"
        android:orientation="horizontal" android:gravity="center_vertical" android:elevation="8dp"
        android:layout_marginTop="@dimen/_5sdp" android:layout_marginEnd="@dimen/_6sdp"
        app:layout_constraintTop_toTopOf="parent" app:layout_constraintEnd_toEndOf="parent">
        <com.kdt.mcgui.mcAccountSpinner android:id="@+id/account_spinner"
            android:layout_width="@dimen/_130sdp" android:layout_height="match_parent"
            android:dropDownWidth="@dimen/_250sdp" android:dropDownVerticalOffset="@dimen/_42sdp"
            android:background="@drawable/bg_lucifer_panel" />
        <ImageButton android:id="@+id/setting_button" android:layout_width="@dimen/_40sdp"
            android:layout_height="match_parent" android:layout_marginStart="4dp"
            android:background="@drawable/bg_lucifer_panel" android:padding="@dimen/_9sdp"
            android:src="@drawable/ic_menu_settings" android:contentDescription="@string/lucifer_settings" />
    </LinearLayout>
    <com.kdt.mcgui.ProgressLayout android:id="@+id/progress_layout" android:layout_width="0dp"
        android:layout_height="wrap_content" android:elevation="10dp"
        app:layout_constraintStart_toEndOf="@id/launcher_rail" app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>
