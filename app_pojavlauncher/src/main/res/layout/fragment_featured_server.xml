<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0E121A">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/featured_server_canvas"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginHorizontal="@dimen/_6sdp"
        app:layout_constraintDimensionRatio="H,16:9"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:id="@+id/featured_server_screenshot"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:scaleType="fitXY"
            android:src="@drawable/lucifermc_server_screen"
            android:contentDescription="LuciferMC official Lifesteel SMP server page"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/feature_play_start"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintGuide_percent="0.042" />
        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/feature_play_end"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintGuide_percent="0.724" />
        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/feature_discord_start"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintGuide_percent="0.740" />
        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/feature_discord_end"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintGuide_percent="0.980" />
        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/feature_status_top"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            app:layout_constraintGuide_percent="0.061" />
        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/feature_status_end"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintGuide_percent="0.980" />
        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/feature_buttons_top"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            app:layout_constraintGuide_percent="0.813" />
        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/feature_buttons_bottom"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            app:layout_constraintGuide_percent="0.951" />

        <TextView
            android:id="@+id/featured_server_pin"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/_8sdp"
            android:layout_marginTop="@dimen/_8sdp"
            android:paddingHorizontal="@dimen/_9sdp"
            android:paddingVertical="@dimen/_4sdp"
            android:background="@drawable/bg_server_badge_online"
            android:text="🔒 PINNED"
            android:textColor="#B9FFC9"
            android:textSize="@dimen/_8ssp"
            android:textStyle="bold"
            android:letterSpacing="0.05"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/featured_server_status"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:gravity="center"
            android:minWidth="@dimen/_68sdp"
            android:minHeight="@dimen/_32sdp"
            android:background="@drawable/bg_server_badge_online"
            android:text="ONLINE"
            android:textColor="#82F59A"
            android:textSize="@dimen/_12ssp"
            android:textStyle="bold"
            android:letterSpacing="0.06"
            app:layout_constraintWidth_percent="0.105"
            app:layout_constraintHeight_percent="0.075"
            app:layout_constraintTop_toTopOf="@id/feature_status_top"
            app:layout_constraintEnd_toStartOf="@id/feature_status_end" />

        <!-- Transparent hit targets sit exactly over the Play and Discord buttons in the supplied art. -->
        <View
            android:id="@+id/btn_featured_server_play"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:minHeight="@dimen/_42sdp"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="Play and join LuciferMC Lifesteel SMP"
            app:layout_constraintStart_toStartOf="@id/feature_play_start"
            app:layout_constraintEnd_toStartOf="@id/feature_play_end"
            app:layout_constraintTop_toTopOf="@id/feature_buttons_top"
            app:layout_constraintBottom_toTopOf="@id/feature_buttons_bottom" />

        <View
            android:id="@+id/btn_featured_server_discord"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:minHeight="@dimen/_42sdp"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="Join the Lucifer Launcher Discord server"
            app:layout_constraintStart_toStartOf="@id/feature_discord_start"
            app:layout_constraintEnd_toStartOf="@id/feature_discord_end"
            app:layout_constraintTop_toTopOf="@id/feature_buttons_top"
            app:layout_constraintBottom_toTopOf="@id/feature_buttons_bottom" />
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
