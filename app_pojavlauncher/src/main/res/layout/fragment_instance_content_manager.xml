<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/instance_content_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_lucifer_scene_gradient">

    <ImageView
        android:id="@+id/instance_content_background"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0.55"
        android:contentDescription=""
        android:scaleType="centerCrop" />

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#78050B12" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/_9sdp"
        android:paddingTop="@dimen/_8sdp"
        android:paddingBottom="@dimen/_6sdp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/_54sdp"
            android:background="@drawable/bg_lucifer_glass_card"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="@dimen/_9sdp">

            <TextView
                android:id="@+id/instance_content_back"
                android:layout_width="@dimen/_36sdp"
                android:layout_height="@dimen/_36sdp"
                android:background="@drawable/bg_lucifer_nav_item"
                android:clickable="true"
                android:contentDescription="@string/global_back"
                android:focusable="true"
                android:gravity="center"
                android:text="‹"
                android:textColor="?attr/luciferAccent"
                android:textSize="@dimen/_24ssp" />

            <ImageView
                android:id="@+id/instance_content_profile_icon"
                android:layout_width="@dimen/_38sdp"
                android:layout_height="@dimen/_38sdp"
                android:layout_marginStart="@dimen/_8sdp"
                android:background="@drawable/bg_profile_icon_rounded"
                android:contentDescription="@string/instance_content_profile_icon"
                android:padding="@dimen/_3sdp"
                android:scaleType="fitCenter"
                android:src="@drawable/lucifer_launcher_emblem" />

            <LinearLayout
                android:id="@+id/instance_content_profile_selector"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="@dimen/_8sdp"
                android:layout_weight="1"
                android:clickable="true"
                android:contentDescription="@string/instance_content_profile_switch"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/instance_content_profile_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/text_primary_white"
                    android:textSize="@dimen/_12ssp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/instance_content_profile_version"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_1sdp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="?attr/luciferAccent"
                    android:textSize="@dimen/_8ssp" />
            </LinearLayout>

            <TextView
                android:id="@+id/instance_content_set_background"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/_36sdp"
                android:layout_marginStart="@dimen/_8sdp"
                android:background="@drawable/bg_lucifer_nav_item"
                android:clickable="true"
                android:contentDescription="@string/instance_content_set_background"
                android:focusable="true"
                android:gravity="center"
                android:paddingHorizontal="@dimen/_10sdp"
                android:text="@string/instance_content_set_background"
                android:textColor="@color/text_primary_white"
                android:textSize="@dimen/_8ssp" />

            <TextView
                android:id="@+id/instance_content_clear_background"
                android:layout_width="@dimen/_34sdp"
                android:layout_height="@dimen/_36sdp"
                android:layout_marginStart="@dimen/_5sdp"
                android:background="@drawable/bg_lucifer_nav_item"
                android:clickable="true"
                android:contentDescription="@string/instance_content_clear_background"
                android:focusable="true"
                android:gravity="center"
                android:text="×"
                android:textColor="@color/text_primary_white"
                android:textSize="@dimen/_18ssp"
                android:visibility="gone" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="@dimen/_8sdp"
            android:layout_weight="1"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="@dimen/_128sdp"
                android:layout_height="match_parent"
                android:background="@drawable/bg_lucifer_glass_card"
                android:orientation="vertical"
                android:padding="@dimen/_7sdp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/_25sdp"
                    android:gravity="center_vertical"
                    android:paddingStart="@dimen/_6sdp"
                    android:text="INSTANCE CONTENT"
                    android:textColor="@color/text_secondary_light"
                    android:textSize="@dimen/_7ssp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/instance_content_tab_mods"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/_40sdp"
                    android:layout_marginBottom="@dimen/_5sdp"
                    android:background="@drawable/bg_lucifer_nav_item"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="@dimen/_8sdp"
                    android:text="◈  Mods"
                    android:textColor="@color/text_primary_white"
                    android:textSize="@dimen/_9ssp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/instance_content_tab_packs"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/_40sdp"
                    android:layout_marginBottom="@dimen/_5sdp"
                    android:background="@drawable/bg_lucifer_nav_item"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="@dimen/_8sdp"
                    android:text="▣  Packs"
                    android:textColor="@color/text_primary_white"
                    android:textSize="@dimen/_9ssp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/instance_content_tab_shaders"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/_40sdp"
                    android:layout_marginBottom="@dimen/_5sdp"
                    android:background="@drawable/bg_lucifer_nav_item"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="@dimen/_8sdp"
                    android:text="✦  Shaders"
                    android:textColor="@color/text_primary_white"
                    android:textSize="@dimen/_9ssp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/instance_content_tab_worlds"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/_40sdp"
                    android:layout_marginBottom="@dimen/_5sdp"
                    android:background="@drawable/bg_lucifer_nav_item"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="@dimen/_8sdp"
                    android:text="◉  Worlds"
                    android:textColor="@color/text_primary_white"
                    android:textSize="@dimen/_9ssp"
                    android:textStyle="bold" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:padding="@dimen/_5sdp"
                    android:text="Disabled items stay in this instance and can be restored here."
                    android:textColor="@color/text_secondary_light"
                    android:textSize="@dimen/_7ssp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="@dimen/_8sdp"
                android:layout_weight="1"
                android:background="@drawable/bg_lucifer_glass_card"
                android:orientation="vertical"
                android:padding="@dimen/_9sdp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/_38sdp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <EditText
                        android:id="@+id/instance_content_search"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@drawable/bg_lucifer_nav_item"
                        android:drawableStart="@drawable/ic_search"
                        android:drawablePadding="@dimen/_5sdp"
                        android:hint="@string/instance_content_search_hint"
                        android:imeOptions="actionSearch"
                        android:inputType="text"
                        android:maxLines="1"
                        android:paddingHorizontal="@dimen/_8sdp"
                        android:textColor="@color/text_primary_white"
                        android:textColorHint="@color/text_secondary_light"
                        android:textSize="@dimen/_8ssp" />

                    <TextView
                        android:id="@+id/instance_content_filter"
                        android:layout_width="@dimen/_76sdp"
                        android:layout_height="match_parent"
                        android:layout_marginStart="@dimen/_5sdp"
                        android:background="@drawable/bg_lucifer_nav_item"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:text="All 0  ▾"
                        android:textColor="@color/text_primary_white"
                        android:textSize="@dimen/_8ssp" />

                    <TextView
                        android:id="@+id/instance_content_open_folder"
                        android:layout_width="@dimen/_34sdp"
                        android:layout_height="match_parent"
                        android:layout_marginStart="@dimen/_5sdp"
                        android:background="@drawable/bg_lucifer_nav_item"
                        android:clickable="true"
                        android:contentDescription="@string/instance_content_open_folder"
                        android:focusable="true"
                        android:gravity="center"
                        android:text="↗"
                        android:textColor="@color/text_primary_white"
                        android:textSize="@dimen/_14ssp" />

                    <TextView
                        android:id="@+id/instance_content_refresh"
                        android:layout_width="@dimen/_34sdp"
                        android:layout_height="match_parent"
                        android:layout_marginStart="@dimen/_5sdp"
                        android:background="@drawable/bg_lucifer_nav_item"
                        android:clickable="true"
                        android:contentDescription="@string/instance_content_refresh"
                        android:focusable="true"
                        android:gravity="center"
                        android:text="⟳"
                        android:textColor="?attr/luciferAccent"
                        android:textSize="@dimen/_15ssp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_7sdp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/instance_content_section_title"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="SELECT ITEMS"
                        android:textColor="?attr/luciferAccent"
                        android:textSize="@dimen/_9ssp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/instance_content_count"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/text_secondary_light"
                        android:textSize="@dimen/_8ssp" />
                </LinearLayout>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/instance_content_recycler"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_marginTop="@dimen/_6sdp"
                    android:layout_weight="1"
                    android:clipToPadding="false"
                    android:overScrollMode="never"
                    android:paddingBottom="@dimen/_5sdp" />

                <LinearLayout
                    android:id="@+id/instance_content_empty"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/instance_content_empty_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/instance_content_empty_title"
                        android:textColor="@color/text_primary_white"
                        android:textSize="@dimen/_12ssp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_4sdp"
                        android:gravity="center"
                        android:text="@string/instance_content_empty_detail"
                        android:textColor="@color/text_secondary_light"
                        android:textSize="@dimen/_8ssp" />
                </LinearLayout>

                <FrameLayout
                    android:id="@+id/instance_content_loading"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:visibility="gone">

                    <ProgressBar
                        android:id="@+id/instance_content_progress"
                        style="?android:attr/progressBarStyleSmall"
                        android:layout_width="@dimen/_30sdp"
                        android:layout_height="@dimen/_30sdp"
                        android:layout_gravity="center"
                        android:indeterminateTint="?attr/luciferAccent" />
                </FrameLayout>
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="@dimen/_19sdp"
            android:gravity="center_vertical"
            android:paddingStart="@dimen/_4sdp"
            android:text="@string/instance_content_changes_hint"
            android:textColor="@color/text_secondary_light"
            android:textSize="@dimen/_7ssp" />
    </LinearLayout>
</FrameLayout>
