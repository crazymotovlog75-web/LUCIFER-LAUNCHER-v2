<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/instance_picker_profile_card"
    android:layout_width="match_parent"
    android:layout_height="@dimen/_68sdp"
    android:layout_marginVertical="@dimen/_3sdp"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingHorizontal="@dimen/_12sdp"
    android:background="@drawable/bg_lucifer_glass_card"
    android:clickable="true"
    android:focusable="true">

    <ImageView
        android:id="@+id/instance_picker_profile_icon"
        android:layout_width="@dimen/_42sdp"
        android:layout_height="@dimen/_42sdp"
        android:layout_marginEnd="@dimen/_10sdp"
        android:padding="@dimen/_3sdp"
        android:scaleType="fitCenter"
        android:background="@drawable/bg_profile_icon_rounded"
        android:contentDescription="Minecraft instance icon" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">
        <TextView
            android:id="@+id/instance_picker_profile_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/text_primary_white"
            android:textSize="@dimen/_11ssp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end" />
        <TextView
            android:id="@+id/instance_picker_profile_version"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_2sdp"
            android:textColor="?attr/luciferAccent"
            android:textSize="@dimen/_9ssp"
            android:maxLines="1"
            android:ellipsize="end" />
        <TextView
            android:id="@+id/instance_picker_profile_last_used"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_1sdp"
            android:textColor="@color/text_secondary_light"
            android:textSize="@dimen/_8ssp"
            android:maxLines="1"
            android:ellipsize="end" />
    </LinearLayout>

    <TextView
        android:id="@+id/instance_picker_profile_active"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/_25sdp"
        android:layout_marginStart="@dimen/_8sdp"
        android:gravity="center"
        android:paddingHorizontal="@dimen/_9sdp"
        android:background="@drawable/bg_server_badge_online"
        android:text="SELECTED"
        android:textColor="#82F59A"
        android:textSize="@dimen/_8ssp"
        android:textStyle="bold"
        android:visibility="gone" />

    <TextView
        android:id="@+id/instance_picker_profile_menu"
        android:layout_width="@dimen/_30sdp"
        android:layout_height="@dimen/_38sdp"
        android:layout_marginStart="@dimen/_3sdp"
        android:gravity="center"
        android:text="⋮"
        android:textColor="@color/text_primary_white"
        android:textSize="@dimen/_19ssp"
        android:contentDescription="@string/instance_actions_description"
        android:background="@drawable/bg_lucifer_nav_item"
        android:clickable="true"
        android:focusable="true" />
</LinearLayout>
