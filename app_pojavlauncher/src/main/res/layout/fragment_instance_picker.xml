<?xml version="1.0" encoding="utf-8"?>
<!-- Liquid Crystal — Instances pane (mockup screen 03) -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent"
    android:orientation="vertical"
    android:paddingStart="@dimen/lc_screen_pad"
    android:paddingTop="@dimen/lc_gap"
    android:paddingEnd="@dimen/lc_screen_pad"
    android:paddingBottom="@dimen/lc_gap">

    <!-- glass header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <FrameLayout
            android:id="@+id/instance_picker_back"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/lc_orb_button"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:contentDescription="@string/global_back"
                android:src="@drawable/ic_arrow_back_white" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/mcl_section_instances"
                android:textColor="@color/lc_text"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/lc_instances_sub"
                android:textColor="@color/lc_text_dim"
                android:textSize="11sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/instance_picker_versions"
            style="@style/LcGhostButton"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:text="@string/lc_version_manager_title" />
    </LinearLayout>

    <!-- instance list -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/instance_picker_recycler"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/lc_gap"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:scrollbars="none" />

</LinearLayout>
