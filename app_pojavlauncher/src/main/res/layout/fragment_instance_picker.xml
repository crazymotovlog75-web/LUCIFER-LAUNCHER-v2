<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingHorizontal="@dimen/_16sdp"
    android:paddingTop="@dimen/_10sdp"
    android:background="@drawable/bg_lucifer_scene">

    <LinearLayout
        android:id="@+id/instance_picker_header"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="@dimen/_12sdp"
        android:background="@drawable/bg_lucifer_glass_card"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">
        <TextView
            android:id="@+id/instance_picker_back"
            android:layout_width="@dimen/_38sdp"
            android:layout_height="@dimen/_36sdp"
            android:gravity="center"
            android:text="‹"
            android:textColor="?attr/luciferAccent"
            android:textSize="@dimen/_23ssp"
            android:background="@drawable/bg_lucifer_nav_item"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="@string/global_back" />
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="@dimen/_10sdp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="INSTANCES &amp; BUILDS"
                android:textColor="@color/text_primary_white"
                android:textSize="@dimen/_17ssp"
                android:textStyle="bold" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_2sdp"
                android:text="Profiles, versions and mod loaders"
                android:textColor="@color/text_secondary_light"
                android:textSize="@dimen/_9ssp" />
        </LinearLayout>
        <TextView
            android:id="@+id/instance_picker_count"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/_30sdp"
            android:gravity="center"
            android:paddingHorizontal="@dimen/_9sdp"
            android:textColor="?attr/luciferAccent"
            android:textSize="@dimen/_9ssp"
            android:background="@drawable/bg_lucifer_nav_item" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/instance_picker_actions"
        android:layout_width="0dp"
        android:layout_height="@dimen/_40sdp"
        android:layout_marginTop="@dimen/_9sdp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        app:layout_constraintTop_toBottomOf="@id/instance_picker_header"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">
        <EditText
            android:id="@+id/instance_picker_search"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/bg_lucifer_glass_card"
            android:drawableStart="@drawable/ic_search"
            android:drawablePadding="@dimen/_6sdp"
            android:hint="Search instances"
            android:imeOptions="actionSearch"
            android:inputType="text"
            android:maxLines="1"
            android:paddingHorizontal="@dimen/_12sdp"
            android:textColor="@color/text_primary_white"
            android:textColorHint="@color/text_secondary_light"
            android:textSize="@dimen/_10ssp" />
        <TextView
            android:id="@+id/instance_picker_add"
            android:layout_width="@dimen/_116sdp"
            android:layout_height="match_parent"
            android:layout_marginStart="@dimen/_8sdp"
            android:gravity="center"
            android:text="＋ Add instance"
            android:textColor="?attr/luciferOnAccent"
            android:textSize="@dimen/_9ssp"
            android:textStyle="bold"
            android:background="@drawable/bg_lucifer_action"
            android:clickable="true"
            android:focusable="true" />
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/instance_picker_recycler"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/_7sdp"
        android:clipToPadding="false"
        android:paddingBottom="@dimen/_9sdp"
        android:overScrollMode="never"
        app:layout_constraintTop_toBottomOf="@id/instance_picker_actions"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <LinearLayout
        android:id="@+id/instance_picker_empty"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="@dimen/_24sdp"
        android:background="@drawable/bg_lucifer_glass_card"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="@id/instance_picker_recycler"
        app:layout_constraintBottom_toBottomOf="@id/instance_picker_recycler"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">
        <TextView
            android:id="@+id/instance_picker_empty_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="No matching instances"
            android:textColor="@color/text_primary_white"
            android:textSize="@dimen/_14ssp"
            android:textStyle="bold" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_5sdp"
            android:gravity="center"
            android:text="Clear the search or add a new Minecraft build."
            android:textColor="@color/text_secondary_light"
            android:textSize="@dimen/_9ssp" />
    </LinearLayout>

    <ProgressBar
        android:id="@+id/instance_picker_progress"
        style="?android:attr/progressBarStyleSmall"
        android:layout_width="@dimen/_34sdp"
        android:layout_height="@dimen/_34sdp"
        android:indeterminateTint="?attr/luciferAccent"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="@id/instance_picker_recycler"
        app:layout_constraintBottom_toBottomOf="@id/instance_picker_recycler"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>
