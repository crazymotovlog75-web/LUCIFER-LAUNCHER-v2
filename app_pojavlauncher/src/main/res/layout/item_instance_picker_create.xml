<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/instance_picker_create_card"
    android:layout_width="match_parent"
    android:layout_height="@dimen/_56sdp"
    android:layout_marginVertical="@dimen/_3sdp"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingHorizontal="@dimen/_14sdp"
    android:background="@drawable/bg_lucifer_glass_card"
    android:clickable="true"
    android:focusable="true">
    <TextView
        android:layout_width="@dimen/_34sdp"
        android:layout_height="@dimen/_34sdp"
        android:gravity="center"
        android:text="＋"
        android:textColor="?attr/luciferAccent"
        android:textSize="@dimen/_18ssp" />
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/_8sdp"
        android:orientation="vertical">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Create or install an instance"
            android:textColor="@color/text_primary_white"
            android:textSize="@dimen/_10ssp"
            android:textStyle="bold" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_2sdp"
            android:text="Minecraft releases, snapshots and mod loaders"
            android:textColor="@color/text_secondary_light"
            android:textSize="@dimen/_8ssp" />
    </LinearLayout>
</LinearLayout>
