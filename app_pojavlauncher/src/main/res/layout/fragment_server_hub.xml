<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingHorizontal="@dimen/_12sdp"
    android:paddingTop="@dimen/_8sdp"
    android:background="@android:color/transparent">

    <LinearLayout
        android:id="@+id/server_header"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingVertical="@dimen/_6sdp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">
        <TextView
            android:id="@+id/server_hub_back"
            android:layout_width="@dimen/_42sdp"
            android:layout_height="@dimen/_42sdp"
            android:gravity="center"
            android:text="‹"
            android:textColor="@color/text_primary_white"
            android:textSize="@dimen/_26ssp"
            android:background="@drawable/bg_lucifer_nav_item"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="Back" />
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="@dimen/_12sdp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Server Hub"
                android:textColor="@color/text_primary_white"
                android:textSize="@dimen/_18ssp"
                android:textStyle="bold" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_2sdp"
                android:text="Profile default · live status and one-tap join"
                android:textColor="@color/text_secondary_light"
                android:textSize="@dimen/_9ssp"
                android:maxLines="2" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/server_hub_count"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_7sdp"
        android:text="1 server · checking now"
        android:textColor="@color/text_secondary_light"
        android:textSize="@dimen/_11ssp"
        android:letterSpacing="0.04"
        app:layout_constraintTop_toBottomOf="@id/server_header"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <LinearLayout
        android:id="@+id/server_hub_actions"
        android:layout_width="0dp"
        android:layout_height="@dimen/_46sdp"
        android:layout_marginTop="@dimen/_7sdp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        app:layout_constraintTop_toBottomOf="@id/server_hub_count"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">
        <TextView
            android:id="@+id/btn_server_refresh_all"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="↻  Refresh"
            android:textColor="@color/text_primary_white"
            android:textSize="@dimen/_11ssp"
            android:textStyle="bold"
            android:background="@drawable/bg_server_refresh_dark"
            android:clickable="true"
            android:focusable="true" />
        <TextView
            android:id="@+id/btn_server_add"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="@dimen/_8sdp"
            android:gravity="center"
            android:text="＋  Add"
            android:textColor="#151923"
            android:textSize="@dimen/_11ssp"
            android:textStyle="bold"
            android:background="@drawable/bg_server_add_light"
            android:clickable="true"
            android:focusable="true" />
    </LinearLayout>

    <include
        android:id="@+id/featured_server_panel"
        layout="@layout/fragment_featured_server"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/_9sdp"
        app:layout_constraintDimensionRatio="H,16:9"
        app:layout_constraintTop_toBottomOf="@id/server_hub_actions"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/server_hub_other_servers_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_8sdp"
        android:text="OTHER SERVERS"
        android:textColor="@color/text_primary_white"
        android:textSize="@dimen/_10ssp"
        android:textStyle="bold"
        android:letterSpacing="0.1"
        app:layout_constraintTop_toBottomOf="@id/featured_server_panel"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/server_hub_list"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingTop="@dimen/_4sdp"
        android:paddingBottom="@dimen/_8sdp"
        android:overScrollMode="never"
        app:layout_constraintTop_toBottomOf="@id/server_hub_other_servers_title"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <LinearLayout
        android:id="@+id/server_hub_empty"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="@dimen/_14sdp"
        android:background="@drawable/bg_lucifer_glass_card"
        app:layout_constraintTop_toTopOf="@id/server_hub_list"
        app:layout_constraintBottom_toBottomOf="@id/server_hub_list"
        app:layout_constraintStart_toStartOf="@id/server_hub_list"
        app:layout_constraintEnd_toEndOf="@id/server_hub_list">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="No added servers yet"
            android:textColor="@color/text_primary_white"
            android:textSize="@dimen/_13ssp"
            android:textStyle="bold" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_4sdp"
            android:text="LuciferMC stays pinned above. Add another server and it will appear here with its own Play button."
            android:gravity="center"
            android:textColor="@color/text_secondary_light"
            android:textSize="@dimen/_9ssp" />
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
