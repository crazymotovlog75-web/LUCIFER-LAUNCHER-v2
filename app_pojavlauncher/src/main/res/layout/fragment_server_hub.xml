<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingHorizontal="@dimen/_16sdp"
    android:paddingTop="@dimen/_10sdp"
    android:background="@drawable/bg_lucifer_scene">

    <LinearLayout
        android:id="@+id/server_header"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="@dimen/_12sdp"
        android:background="@drawable/bg_lucifer_glass_card"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">
        <TextView
            android:id="@+id/server_hub_back"
            android:layout_width="@dimen/_38sdp"
            android:layout_height="@dimen/_36sdp"
            android:gravity="center"
            android:text="‹"
            android:textColor="?attr/luciferAccent"
            android:textSize="@dimen/_23ssp"
            android:background="@drawable/bg_lucifer_nav_item"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="Back" />
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="@dimen/_10sdp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SERVER HUB"
                android:textColor="@color/text_primary_white"
                android:textSize="@dimen/_18ssp"
                android:textStyle="bold" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_2sdp"
                android:text="Saved servers · live Java status · Quick Play on supported versions"
                android:textColor="@color/text_secondary_light"
                android:textSize="@dimen/_9ssp" />
        </LinearLayout>
        <TextView
            android:id="@+id/btn_server_refresh_all"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/_34sdp"
            android:gravity="center"
            android:paddingHorizontal="@dimen/_10sdp"
            android:text="↻ Refresh"
            android:textColor="?attr/luciferAccent"
            android:textSize="@dimen/_9ssp"
            android:background="@drawable/bg_lucifer_nav_item"
            android:clickable="true"
            android:focusable="true" />
        <TextView
            android:id="@+id/btn_server_add"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/_34sdp"
            android:layout_marginStart="@dimen/_7sdp"
            android:gravity="center"
            android:paddingHorizontal="@dimen/_12sdp"
            android:text="＋ Add server"
            android:textColor="?attr/luciferOnAccent"
            android:textSize="@dimen/_9ssp"
            android:textStyle="bold"
            android:background="@drawable/bg_lucifer_action"
            android:clickable="true"
            android:focusable="true" />
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/server_hub_list"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingTop="@dimen/_8sdp"
        android:paddingBottom="@dimen/_8sdp"
        android:overScrollMode="never"
        app:layout_constraintTop_toBottomOf="@id/server_header"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <LinearLayout
        android:id="@+id/server_hub_empty"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="@dimen/_26sdp"
        android:background="@drawable/bg_lucifer_glass_card"
        app:layout_constraintTop_toTopOf="@id/server_hub_list"
        app:layout_constraintBottom_toBottomOf="@id/server_hub_list"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="◇"
            android:textColor="?attr/luciferAccent"
            android:textSize="@dimen/_30ssp" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_8sdp"
            android:text="Your server constellation is empty"
            android:textColor="@color/text_primary_white"
            android:textSize="@dimen/_15ssp"
            android:textStyle="bold" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_4sdp"
            android:text="Add an address to save it here, check live status, and Quick Play into supported Minecraft versions."
            android:gravity="center"
            android:textColor="@color/text_secondary_light"
            android:textSize="@dimen/_10ssp" />
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
