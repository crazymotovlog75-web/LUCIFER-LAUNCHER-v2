<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/server_card_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="@dimen/_4sdp"
    android:layout_marginVertical="@dimen/_4sdp"
    android:orientation="vertical"
    android:padding="@dimen/_8sdp"
    android:background="@drawable/bg_lucifer_glass_card">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/_54sdp"
        android:background="@drawable/bg_server_banner_placeholder">
        <ImageView
            android:id="@+id/server_banner"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:background="@drawable/bg_server_banner_placeholder"
            android:contentDescription="Optional server banner; no banner was provided" />
        <TextView
            android:id="@+id/server_banner_placeholder_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="NO SERVER BANNER PROVIDED"
            android:textColor="#99D9D3E6"
            android:textSize="@dimen/_7ssp"
            android:textStyle="bold"
            android:letterSpacing="0.12" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_6sdp"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <ImageView
            android:id="@+id/server_logo"
            android:layout_width="@dimen/_42sdp"
            android:layout_height="@dimen/_42sdp"
            android:layout_marginEnd="@dimen/_8sdp"
            android:padding="@dimen/_4sdp"
            android:background="@drawable/bg_server_icon"
            android:scaleType="centerInside"
            android:src="@drawable/ic_server_placeholder"
            android:contentDescription="Generic server logo; server favicon not available" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView
                android:id="@+id/tv_server_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/text_primary_white"
                android:textSize="@dimen/_12ssp"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end" />
            <TextView
                android:id="@+id/tv_server_address"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_2sdp"
                android:textColor="?attr/luciferAccent"
                android:textSize="@dimen/_8ssp"
                android:maxLines="1"
                android:ellipsize="end" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_5sdp"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <View
            android:id="@+id/server_status_dot"
            android:layout_width="@dimen/_7sdp"
            android:layout_height="@dimen/_7sdp"
            android:layout_marginEnd="@dimen/_5sdp"
            android:background="@drawable/bg_dot_checking" />
        <TextView
            android:id="@+id/tv_server_status"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Checking live status…"
            android:textColor="@color/text_primary_white"
            android:textSize="@dimen/_9ssp"
            android:maxLines="1"
            android:ellipsize="end" />
        <TextView
            android:id="@+id/tv_server_players"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/_6sdp"
            android:text="Players unavailable"
            android:textColor="@color/text_secondary_light"
            android:textSize="@dimen/_8ssp"
            android:maxLines="1" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_3sdp"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <TextView
            android:id="@+id/tv_server_details"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Version unavailable"
            android:textColor="@color/text_secondary_light"
            android:textSize="@dimen/_8ssp"
            android:maxLines="1"
            android:ellipsize="end" />
        <TextView
            android:id="@+id/tv_server_ping"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Ping unavailable"
            android:textColor="@color/text_secondary_light"
            android:textSize="@dimen/_8ssp"
            android:maxLines="1" />
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_5sdp"
        android:text="MESSAGE OF THE DAY"
        android:textColor="?attr/luciferAccent"
        android:textSize="@dimen/_7ssp"
        android:textStyle="bold"
        android:letterSpacing="0.10" />
    <TextView
        android:id="@+id/tv_server_motd"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="@dimen/_20sdp"
        android:layout_marginTop="@dimen/_1sdp"
        android:text="MOTD unavailable"
        android:textColor="@color/text_primary_white"
        android:textSize="@dimen/_8ssp"
        android:maxLines="2"
        android:ellipsize="end" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/_34sdp"
        android:layout_marginTop="@dimen/_5sdp"
        android:orientation="horizontal"
        android:gravity="center_vertical">
        <TextView
            android:id="@+id/btn_server_connect"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginEnd="@dimen/_5sdp"
            android:gravity="center"
            android:text="▶  PLAY"
            android:textColor="#101713"
            android:textSize="@dimen/_9ssp"
            android:textStyle="bold"
            android:background="@drawable/bg_server_play"
            android:clickable="true"
            android:focusable="true" />
        <TextView
            android:id="@+id/btn_server_discord"
            android:layout_width="@dimen/_62sdp"
            android:layout_height="match_parent"
            android:layout_marginEnd="@dimen/_5sdp"
            android:gravity="center"
            android:text="DISCORD"
            android:textColor="#FFFFFF"
            android:textSize="@dimen/_7ssp"
            android:textStyle="bold"
            android:background="@drawable/bg_discord_join"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="Open this server's configured Discord or website link" />
        <TextView
            android:id="@+id/btn_server_ping"
            android:layout_width="@dimen/_32sdp"
            android:layout_height="match_parent"
            android:layout_marginEnd="@dimen/_4sdp"
            android:gravity="center"
            android:text="↻"
            android:textColor="?attr/luciferAccent"
            android:textSize="@dimen/_14ssp"
            android:background="@drawable/bg_lucifer_nav_item"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="Refresh server status" />
        <TextView
            android:id="@+id/btn_server_edit"
            android:layout_width="@dimen/_32sdp"
            android:layout_height="match_parent"
            android:layout_marginEnd="@dimen/_4sdp"
            android:gravity="center"
            android:text="⋯"
            android:textColor="@color/text_primary_white"
            android:textSize="@dimen/_15ssp"
            android:background="@drawable/bg_lucifer_nav_item"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="Edit server" />
        <TextView
            android:id="@+id/btn_server_delete"
            android:layout_width="@dimen/_32sdp"
            android:layout_height="match_parent"
            android:layout_marginStart="@dimen/_4sdp"
            android:gravity="center"
            android:text="×"
            android:textColor="#FFFF91A8"
            android:textSize="@dimen/_16ssp"
            android:background="@drawable/bg_lucifer_nav_item"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="Remove server" />
    </LinearLayout>
</LinearLayout>
