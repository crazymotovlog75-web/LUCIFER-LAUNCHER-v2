<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/server_card_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginVertical="@dimen/_5sdp"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:padding="@dimen/_12sdp"
    android:background="@drawable/bg_lucifer_glass_card">

    <View
        android:id="@+id/server_status_dot"
        android:layout_width="@dimen/_8sdp"
        android:layout_height="@dimen/_8sdp"
        android:layout_marginEnd="@dimen/_10sdp"
        android:background="@drawable/bg_dot_online" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">
        <TextView
            android:id="@+id/tv_server_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/text_primary_white"
            android:textSize="@dimen/_13ssp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end" />
        <TextView
            android:id="@+id/tv_server_address"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_2sdp"
            android:textColor="?attr/luciferAccent"
            android:textSize="@dimen/_9ssp"
            android:maxLines="1"
            android:ellipsize="end" />
        <TextView
            android:id="@+id/tv_server_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_5sdp"
            android:text="Not checked"
            android:textColor="@color/text_secondary_light"
            android:textSize="@dimen/_9ssp"
            android:maxLines="1"
            android:ellipsize="end" />
    </LinearLayout>

    <TextView
        android:id="@+id/tv_server_details"
        android:layout_width="@dimen/_108sdp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/_10sdp"
        android:gravity="center"
        android:textColor="@color/text_secondary_light"
        android:textSize="@dimen/_9ssp"
        android:maxLines="2" />

    <TextView
        android:id="@+id/btn_server_connect"
        android:layout_width="@dimen/_70sdp"
        android:layout_height="@dimen/_36sdp"
        android:gravity="center"
        android:text="Quick Play"
        android:textColor="?attr/luciferOnAccent"
        android:textSize="@dimen/_8ssp"
        android:textStyle="bold"
        android:background="@drawable/bg_lucifer_action"
        android:clickable="true"
        android:focusable="true" />

    <TextView
        android:id="@+id/btn_server_ping"
        android:layout_width="@dimen/_34sdp"
        android:layout_height="@dimen/_34sdp"
        android:layout_marginStart="@dimen/_4sdp"
        android:gravity="center"
        android:text="↻"
        android:textColor="?attr/luciferAccent"
        android:textSize="@dimen/_14ssp"
        android:background="@drawable/bg_lucifer_nav_item"
        android:clickable="true"
        android:focusable="true"
        android:contentDescription="Refresh server status" />

    <TextView
        android:id="@+id/btn_server_edit"
        android:layout_width="@dimen/_34sdp"
        android:layout_height="@dimen/_34sdp"
        android:layout_marginStart="@dimen/_4sdp"
        android:gravity="center"
        android:text="⋯"
        android:textColor="@color/text_primary_white"
        android:textSize="@dimen/_15ssp"
        android:background="@drawable/bg_lucifer_nav_item"
        android:clickable="true"
        android:focusable="true"
        android:contentDescription="Edit server" />

    <TextView
        android:id="@+id/btn_server_delete"
        android:layout_width="@dimen/_34sdp"
        android:layout_height="@dimen/_34sdp"
        android:layout_marginStart="@dimen/_4sdp"
        android:gravity="center"
        android:text="×"
        android:textColor="#FFFF91A8"
        android:textSize="@dimen/_14ssp"
        android:background="@drawable/bg_lucifer_nav_item"
        android:clickable="true"
        android:focusable="true"
        android:contentDescription="Remove server" />
</LinearLayout>
