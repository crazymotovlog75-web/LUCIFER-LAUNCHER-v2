<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="315"
                android:startColor="?attr/luciferGlassHigh"
                android:centerColor="?attr/luciferGlass"
                android:endColor="?attr/luciferGlassHigh" />
            <corners android:radius="22dp" />
            <stroke android:width="1dp" android:color="?attr/luciferBorder" />
        </shape>
    </item>
    <item android:left="1dp" android:top="1dp" android:right="1dp">
        <shape android:shape="rectangle">
            <corners android:radius="21dp" />
            <stroke android:width="1dp" android:color="#18FFFFFF" />
        </shape>
    </item>
</layer-list>
