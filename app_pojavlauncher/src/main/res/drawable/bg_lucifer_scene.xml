<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="?attr/luciferWallpaper" />
    <item>
        <shape android:shape="rectangle">
            <solid android:color="?attr/luciferBackdrop" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="#10000000"
                android:centerColor="#05000000"
                android:endColor="#38000000" />
        </shape>
    </item>
</layer-list>
