<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="0" android:startColor="#E51B2635" android:centerColor="#D10E1725" android:endColor="#E5141928" />
            <corners android:radius="24dp" />
            <stroke android:width="1dp" android:color="#587CE5E8" />
        </shape>
    </item>
    <item android:left="1dp" android:top="1dp" android:right="1dp">
        <shape android:shape="rectangle">
            <corners android:radius="24dp" />
            <stroke android:width="1dp" android:color="#18FFFFFF" />
        </shape>
    </item>
</layer-list>
