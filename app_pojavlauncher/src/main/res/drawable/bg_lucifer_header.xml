<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="90" android:startColor="?attr/luciferGlassHigh" android:endColor="?attr/luciferGlass" />
        </shape>
    </item>
    <item android:gravity="bottom" android:height="1dp">
        <shape android:shape="rectangle">
            <solid android:color="?attr/luciferBorder" />
        </shape>
    </item>
</layer-list>
