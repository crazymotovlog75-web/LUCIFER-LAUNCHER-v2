<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <solid android:color="#55233142" />
            <corners android:radius="16dp" />
            <stroke android:width="1dp" android:color="#4462778E" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <gradient android:angle="0" android:startColor="#C151C5CE" android:endColor="#C47E71D1" />
            <corners android:radius="16dp" />
            <stroke android:width="1.5dp" android:color="#D8FFFFFF" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="0" android:startColor="#B132A6B6" android:endColor="#B25B56A1" />
            <corners android:radius="16dp" />
            <stroke android:width="1dp" android:color="#9ACAF4F5" />
        </shape>
    </item>
</selector>
