<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <gradient android:angle="0" android:startColor="?attr/luciferAccentDim" android:endColor="#1AFFFFFF" />
            <corners android:radius="18dp" />
            <stroke android:width="1dp" android:color="?attr/luciferAccent" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="?attr/luciferAccentDim" />
            <corners android:radius="18dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="?attr/luciferGlass" />
            <corners android:radius="18dp" />
            <stroke android:width="1dp" android:color="?attr/luciferBorder" />
        </shape>
    </item>
</selector>
