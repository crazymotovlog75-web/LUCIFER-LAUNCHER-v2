<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <gradient android:angle="0" android:startColor="#494CB7C4" android:endColor="#3B7869A6" />
            <corners android:radius="18dp" />
            <stroke android:width="1dp" android:color="#9BCEF2F3" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#527A94A8" />
            <corners android:radius="18dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#18FFFFFF" />
            <corners android:radius="18dp" />
            <stroke android:width="1dp" android:color="#22C7E5F6" />
        </shape>
    </item>
</selector>
