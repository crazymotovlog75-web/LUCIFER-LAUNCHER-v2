<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="?attr/luciferGlass" />
            <corners android:radius="16dp" />
            <stroke android:width="1.5dp" android:color="#D9FFFFFF" />
        </shape>
    </item>
    <item android:left="2dp" android:top="2dp" android:right="2dp" android:bottom="2dp">
        <shape android:shape="rectangle">
            <corners android:radius="14dp" />
            <stroke android:width="1dp" android:color="#24FFFFFF" />
        </shape>
    </item>
</layer-list>
