<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <gradient android:angle="315" android:startColor="#A72E6079" android:centerColor="#D21B2635" android:endColor="#9E554D84" />
            <stroke android:width="2dp" android:color="#B9A8FFFF" />
        </shape>
    </item>
    <item android:left="8dp" android:top="8dp" android:right="8dp" android:bottom="8dp">
        <shape android:shape="oval">
            <gradient android:angle="315" android:startColor="#BA1D4B58" android:centerColor="#E10B111B" android:endColor="#B62F2850" />
            <stroke android:width="1dp" android:color="#82A5EDF0" />
        </shape>
    </item>
    <item android:left="16dp" android:top="16dp" android:right="16dp" android:bottom="16dp">
        <shape android:shape="oval">
            <solid android:color="#1AFFFFFF" />
            <stroke android:width="1dp" android:color="#42FFFFFF" />
        </shape>
    </item>
</layer-list>
