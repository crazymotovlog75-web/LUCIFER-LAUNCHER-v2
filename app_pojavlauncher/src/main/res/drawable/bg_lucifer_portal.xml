<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <solid android:color="#12000000" />
            <stroke android:width="2dp" android:color="?attr/luciferBorder" />
        </shape>
    </item>
    <item android:left="10dp" android:top="10dp" android:right="10dp" android:bottom="10dp">
        <shape android:shape="oval">
            <solid android:color="?attr/luciferAccentDim" />
            <stroke android:width="1dp" android:color="?attr/luciferAccent" />
        </shape>
    </item>
    <item android:left="22dp" android:top="22dp" android:right="22dp" android:bottom="22dp">
        <shape android:shape="oval">
            <gradient android:angle="45" android:startColor="?attr/luciferAccent" android:endColor="?attr/luciferSecondary" />
            <stroke android:width="1dp" android:color="#99FFFFFF" />
        </shape>
    </item>
    <item android:left="34dp" android:top="34dp" android:right="34dp" android:bottom="34dp">
        <shape android:shape="oval">
            <solid android:color="?attr/luciferGlassHigh" />
            <stroke android:width="1dp" android:color="?attr/luciferBorder" />
        </shape>
    </item>
</layer-list>
