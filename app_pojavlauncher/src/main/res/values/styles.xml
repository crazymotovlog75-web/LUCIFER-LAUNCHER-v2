<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- ── Default (Dark) ───────────────────────────────────── -->
    <style name="AppTheme" parent="@style/Theme.Material3.Dark.NoActionBar">
        <item name="windowNoTitle">true</item>
        <item name="windowActionBar">false</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:statusBarColor">#080B12</item>
        <item name="android:navigationBarColor">#080B12</item>
        <item name="preferenceTheme">@style/PreferenceThemeOverlay.v14.Material</item>
        <item name="android:textSize">@dimen/_12ssp</item>
        <item name="colorBgApp">@color/lucifer_bg</item>
        <item name="colorBgBottomBar">#0A101A</item>
        <item name="colorBgStatusBar">#06090F</item>
        <item name="colorDivider">#3C526273</item>
        <item name="themeAccent">@color/lucifer_cyan</item>
        <item name="colorTextPrimary">@color/primary_text</item>
        <item name="colorTextSecondary">@color/secondary_text</item>
        <item name="bgMainDrawable">@drawable/bg_lucifer_scene</item>
        <item name="android:windowBackground">@drawable/bg_lucifer_scene</item>
        <item name="colorAccent">@color/lucifer_cyan</item>
        <item name="colorOnSurface">@color/primary_text</item>
        <item name="colorOnSurfaceVariant">@color/secondary_text</item>
        <item name="colorSurface">@color/lucifer_surface</item>
        <item name="colorSurfaceVariant">@color/lucifer_surface_high</item>
    </style>
    <style name="AppTheme.Gradient">
        <item name="bgMainDrawable">@drawable/bg_gradient_default</item>
        <item name="android:windowBackground">@drawable/bg_gradient_default</item>
        <item name="colorBgBottomBar">@color/cu_bg_bottom_bar</item>
        <item name="colorBgStatusBar">@color/cu_bg_status_bar</item>
        <item name="colorAccent">#39FF14</item>
    </style>

    <!-- ── Midnight Blue ────────────────────────────────────── -->
    <style name="AppTheme.MidnightBlue">
        <item name="android:statusBarColor">#121212</item>
        <item name="android:navigationBarColor">#121212</item>
        <item name="colorBgApp">#121212</item>
        <item name="colorBgBottomBar">#121212</item>
        <item name="colorBgStatusBar">#121212</item>
        <item name="colorDivider">#464646</item>
        <item name="themeAccent">@color/mb_accent</item>
        <item name="colorTextPrimary">@color/mb_text_primary</item>
        <item name="colorTextSecondary">@color/mb_text_secondary</item>
        <item name="bgMainDrawable">#121212</item>
        <item name="android:windowBackground">#121212</item>
        <item name="colorAccent">#1E90FF</item>
        <item name="colorOnSurface">@color/mb_text_primary</item>
        <item name="colorOnSurfaceVariant">@color/mb_text_secondary</item>
        <item name="colorSurface">#121212</item>
        <item name="colorSurfaceVariant">#1E1E1E</item>
    </style>
    <style name="AppTheme.MidnightBlue.Gradient">
        <item name="android:statusBarColor">@color/mb_bg_status_bar</item>
        <item name="android:navigationBarColor">@color/mb_bg_app</item>
        <item name="bgMainDrawable">@drawable/bg_gradient_midnight_blue</item>
        <item name="android:windowBackground">@drawable/bg_gradient_midnight_blue</item>
        <item name="colorBgBottomBar">@color/mb_bg_bottom_bar</item>
        <item name="colorBgStatusBar">@color/mb_bg_status_bar</item>
        <item name="colorAccent">#1E90FF</item>
    </style>

