    <style name="AppTheme.ForestGreen">
        <item name="android:statusBarColor">#121212</item>
        <item name="android:navigationBarColor">#121212</item>
        <item name="colorBgApp">#121212</item>
        <item name="colorBgBottomBar">#121212</item>
        <item name="colorBgStatusBar">#121212</item>
        <item name="colorDivider">#464646</item>
        <item name="themeAccent">@color/fg_accent</item>
        <item name="colorTextPrimary">@color/fg_text_primary</item>
        <item name="colorTextSecondary">@color/fg_text_secondary</item>
        <item name="bgMainDrawable">#121212</item>
        <item name="android:windowBackground">#121212</item>
        <item name="colorAccent">#4CAF50</item>
        <item name="colorOnSurface">@color/fg_text_primary</item>
        <item name="colorOnSurfaceVariant">@color/fg_text_secondary</item>
